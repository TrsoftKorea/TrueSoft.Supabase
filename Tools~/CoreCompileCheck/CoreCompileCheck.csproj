<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core 레이어 헤드리스 컴파일 체크 (Unity 없이).
    TrueBase.Core는 noEngineReferences=true (UnityEngine 의존 0)라서
    dotnet만으로 컴파일 검증이 가능하다. Unity 컴파일러가 없는 환경에서
    생성자 시그니처 변경·참조 끊김 같은 구조적 오류를 즉시 잡기 위한 도구.

    사용:  dotnet build Tools~/CoreCompileCheck/CoreCompileCheck.csproj

    이 폴더는 이름이 '~'로 끝나 Unity가 완전히 무시한다(.meta 미생성).
    산출 DLL은 버리는 용도 — 목적은 컴파일 성공 여부뿐.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>TrueBase.Core.CompileCheck</AssemblyName>
    <!--
      이 검증의 관심사가 아닌 경고 억제:
      - CS1591: XML 주석 누락
      - CS0649: JSON 역직렬화로만 채워지는 DTO 필드(할당 없음) — 이 코드베이스의 정상 패턴
      진짜 구조적 오류(참조 끊김·시그니처 불일치)만 남도록 한다.
    -->
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core가 참조하는 유일한 외부 패키지. Unity 측 버전(13.x)과 맞춤 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
