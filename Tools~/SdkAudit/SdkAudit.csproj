<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK 규칙 정적 검사 (Unity 없이).

    Runtime/Unity 는 UnityEngine 의존이라 컴파일할 수 없다. 대신 Roslyn 으로 **구문만 파싱**해
    선언·수식어·본문 텍스트를 읽는다. 참조 해석이 필요 없어 UnityEngine 없이도 정확하다.

    검사 항목:
      R1 공개 표면   — Supabase 파사드에 internal 멤버 없음 · Try 접두어 없음 · result 타입 반환
      R2 리셋 대칭성 — 파사드 백킹 필드가 리셋 블록에서 전부 정리됨 · Reset() 보유 파사드는 호출됨
      R3 문서 커버리지 — 문서가 가리키는 API 가 실제 존재함 · 공개 API 가 문서에 있음
      R4 시그니처 일치 — 문서의 선언형 시그니처 파라미터 이름이 코드와 같음

    사용:  dotnet run (프로젝트: Tools~/SdkAudit)
    종료 코드 0 = 통과. 1 = 오류. 경고는 종료 코드에 영향 없음.

    폴더명이 '~'로 끝나 Unity가 완전히 무시한다(.meta 미생성).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SdkAudit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
