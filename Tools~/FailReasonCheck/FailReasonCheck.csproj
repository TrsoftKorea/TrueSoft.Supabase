<Project Sdk="Microsoft.NET.Sdk">

  <!--
    에러코드 카탈로그 무결성 검사 (Unity 없이).
    SupabaseFailCode(enum + FromErrorCode map)와 SupabaseErrorCode(문자열 상수)는 둘 다 Core에 있고
    UnityEngine 의존이 0이라 dotnet으로 함께 컴파일해 리플렉션으로 검증할 수 있다.

    검사 항목:
      1. enum 멤버 ↔ 동명 SupabaseErrorCode 상수 1:1 대응
      2. FromErrorCode(상수값) == 동명 enum 멤버 (map 정합성)
      3. 에러코드 문자열 중복 없음
      4. None/빈문자열/미정의 문자열의 매핑 동작
      5. (경고) Runtime·Editor 어디에서도 방출/참조되지 않는 죽은 사유 탐지

    사용:  dotnet run (프로젝트: Tools~/FailReasonCheck)
    종료 코드 0 = 정합성 OK. 1 = 불일치(하드 오류). 경고는 종료 코드에 영향 없음.

    폴더명이 '~'로 끝나 Unity가 완전히 무시한다(.meta 미생성).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FailReasonCheck</AssemblyName>
    <!-- 포함하지 않은 타입을 가리키는 XML cref·주석 경고는 관심사가 아님 -->
    <NoWarn>$(NoWarn);CS1591;CS1574;CS0419</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Runtime/Core/Models/SupabaseFailCode.cs" />
    <Compile Include="../../Runtime/Core/Models/SupabaseErrorCode.cs" />
  </ItemGroup>

</Project>
